# Vault Obsidian personale (dati, non codice)
/jarvis/

# Immagini temporanee (snapshot camera) per il round-trip verso Claude
/.tmp/

# Profilo Chromium persistente per l'automazione browser (dati, non codice)
/.browser_profile/

# Modello di riconoscimento volto (dati biometrici locali, non codice)
/.face_data/

# Log dei processi avviati da Task Scheduler (setup_autostart.ps1)
/logs/

# Launcher .vbs generati a runtime da setup_autostart.ps1 (path assoluti
# specifici di questa macchina, non codice)
/scripts/

# Voce TTS scelta a caldo (core/voice/tts.py::voice_settings)
.tts-voice.json

# Voce XTTS locale: ambiente separato e clip di riferimento (audio, non codice)
/.venv-xtts/
/jarvis_voice/

# Console dashboard aperta sul PC (core/console_presence.py)
.console-presence.*

# Recap IVECO per il daily (oggetti mail, dati di lavoro)
.iveco-recap.json
.iveco-recap.tmp
.iveco-tickets.json
.iveco-tickets.tmp

# Ultima posizione PC/Watch del ponte VPS
.relay-location.json

# Messaggi comuni Telegram/dashboard (core/feed.py): conversazioni, non codice
/.jarvis-feed.jsonl
/.jarvis-feed.tmp

# Registro spesa LLM (core/costs.py)
.costs.sqlite3*

# Configurazione locale app Watch (URL e token)
watch/JarvisWatch/Config.swift

# Conversazioni dashboard e prossimi step per progetto (core/project_insights.py)
/.jarvis-conversations.jsonl
/.project-insights.json
